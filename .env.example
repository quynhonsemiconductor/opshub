# ───────────────────────────────────────────────────────────────────────────
# OpsHub API — environment configuration
# Copy to .env and fill in. Process refuses to start if required vars are missing.
# ───────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL 18) ─────────────────────────────────────────────────
# Port 5433 matches docker-compose.dev.yml — avoids conflict with other local
# Postgres instances (e.g. rally-api on the default 5432).
# Supply EITHER a complete DATABASE_URL (this file, CI) OR the discrete parts
# DATABASE_HOST/PORT/NAME/USER/PASSWORD. Deployed environments use the parts, so the
# password comes straight from the RDS-managed secret AWS rotates and no copy of it can
# go stale. See db/database-url.ts.
DATABASE_URL=postgres://opshub:opshub@localhost:5433/opshub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
# Privileged connection, used ONLY by db:migrate, the e2e reset and db:roles:enable. Unset
# locally, where DATABASE_URL is already the superuser; set in every deployed environment so
# the app's restricted role cannot run DDL. Migration 0012 creates opshub_app/opshub_worker
# (NOLOGIN) and docs/runbooks/db-role-least-privilege.md covers the cutover.
# DATABASE_MIGRATION_URL=postgres://opshub:opshub@localhost:5433/opshub
# Passwords for the least-privilege roles, consumed by `pnpm db:roles:enable` at cutover.
# [A-Za-z0-9_-] only, 24+ characters — the script refuses anything else. A role whose
# password is unset is SKIPPED, not defaulted.
# DATABASE_APP_PASSWORD=
# DATABASE_WORKER_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Scaffold uses HS256 with a shared secret + a dev-login endpoint.
# Production target: Microsoft Entra ID OIDC SSO (see platform docs).
# JWT — ES256 asymmetric keypair (PEM or base64-encoded PEM)
# Generate:  openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out private.pem
# Base64 for CI/secrets:  base64 -w0 < private.pem
#
# Only the PRIVATE key is configured. JWT_PUBLIC_KEY is derived from it at boot, so a
# mismatched pair — signing works, every verification rejects — is not expressible. Set
# JWT_PUBLIC_KEY only to override with an existing pair.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
COOKIE_SECRET=change-me-in-prod-min-32-chars-cookie
# HMAC key binding a CSRF token to the session that requested it. Distinct from
# COOKIE_SECRET on purpose: that one signs every cookie, so rotating it invalidates all
# of them — sharing one value makes a cookie rotation read as a CSRF change.
CSRF_SECRET=change-me-in-prod-min-32-chars-csrf!!

# ── BFF (Backend-for-Frontend) — server-side Entra OIDC session ───────────────
# The API runs the Authorization-Code + PKCE flow server-side and issues an opaque
# __Host- session cookie, so no token ever reaches the browser. Requires the SPA and the
# API to be same-origin: locally the Vite proxy provides that, and deployed it is the
# Cloudflare Pages Function in apps/web/functions/.
#
# ENTRA_CLIENT_SECRET is a confidential-client secret from the app registration. Leave it
# empty to develop against POST /v1/bff/dev-login instead (non-production only) — the
# login start still works, the callback's token exchange is what needs it.
ENTRA_CLIENT_SECRET=
# Must also be registered as a redirect URI on the Entra app registration. Note the SPA
# origin, not the API origin — the browser lands here and the session cookie is set on
# that response.
ENTRA_REDIRECT_URI=http://localhost:5173/v1/bff/callback
# Where to land after login when no safe returnTo was supplied.
BFF_POST_LOGIN_REDIRECT=/
# Server-side session lifetime in seconds (default 30 days).
BFF_SESSION_TTL_SECONDS=2592000
JWT_ACCESS_EXPIRY=15m
JWT_ISSUER=opshub-api
JWT_AUDIENCE=opshub-web

# ── Microsoft Entra ID SSO (production login) ────────────────────────────────
# Required in production; optional in dev (dev-login is used when these are unset).
# App Role *values* in Azure MUST equal OpsHub role keys (admin, it-admin, security,
# hr, manager, helpdesk, auditor). Full setup: docs/sso-entra-app-roles.md
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Only needed for Microsoft Graph API sync jobs (security posture, workforce, compliance).
# App client-credentials flow — requires Graph application permissions + admin consent.
GRAPH_CLIENT_SECRET=

# ── Cache (Valkey / Redis — optional in dev) ─────────────────────────────────
# Port 6380 matches docker-compose.dev.yml — avoids conflict with other local
# Redis/Valkey instances (e.g. rally-api on the default 6379).
# Leave empty to disable caching in local development.
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=opshub:

# ── AWS (optional in dev) ────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1

# LocalStack — local S3 for uploads, no real account needed. `docker compose -f
# docker-compose.dev.yml up -d` starts it and creates the bucket via the init hook
# (scripts/localstack/01-bootstrap.sh). Port 4567, offset from 4566 so it runs beside
# rally's. StorageService reaches it through STORAGE_ENDPOINT below, NOT these vars —
# they exist only for the bootstrap script and the aws CLI.
#
# There is no SQS queue any more: the domain-event outbox it fed had no consumer, so the
# whole leg was removed (migration 0013). The three outboxes that DO have consumers —
# notifications, email, webhooks — are database-only and need nothing here.
AWS_ENDPOINT_URL=http://localhost:4567

# ── Observability ────────────────────────────────────────────────────────────
SERVICE_VERSION=dev
LOG_LEVEL=info
LOG_PRETTY=true
LOG_SQL=false
# ON by default locally, because the compose stack ships the collector that receives it
# (scripts/otel/collector.yaml). It was false everywhere with no collector anywhere, so
# every `@Span` and every QueueMetrics recording ran and emitted into nothing — correct
# code with no way to notice it had rotted.
#
# Spans and metrics land in `docker logs opshub-otel`; metrics are also readable as
# Prometheus text via `curl -s localhost:8890/metrics`.
#
# Set false if you are running the API without the compose stack, otherwise the SDK
# retries a connection that is not there. Deployed environments derive this from the
# otel-agent module in infra/ and it stays OFF until that is enabled deliberately.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=opshub-api
OTEL_WORKER_SERVICE_NAME=opshub-worker
# Port 4319, not 4318 — see the otel service in docker-compose.dev.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319

# ── Email ────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=dev       → logs to the console and sends nothing (default; no setup at all)
# EMAIL_PROVIDER=ses       → AWS SES, authenticated by the task role. The one to use in a
#                            deployed environment: same account as everything else, no API key
#                            to store. Needs the domain verified in SES and `ses:SendEmail` on
#                            the task role — infra grants the latter; the former is a one-off.
# EMAIL_PROVIDER=resend    → sends via Resend (set RESEND_API_KEY)
#
# MAIL_FROM_EMAIL has no default on purpose. It used to default to this domain, and a deployment
# that did not own it sent mail failing SPF and DKIM — silent non-delivery, nothing in the logs.
# Any non-dev provider now refuses to boot without it.
EMAIL_PROVIDER=dev
MAIL_FROM_NAME=OpsHub
MAIL_FROM_EMAIL=no-reply@opshub.app
# Where replies go. Unset means replies land on the no-reply sender, which is rarely what anybody
# wants once a human is on the other end.
MAIL_REPLY_TO=
# SES only, and optional: tags each send so a bounce or complaint can be tied back to the message.
SES_CONFIGURATION_SET=
RESEND_API_KEY=


# ── App URL (used in email links) ────────────────────────────────────────────
APP_URL=http://localhost:5173

# ── File Storage (S3-compatible) ──────────────────────────────────────────────
# Bucket name must match BUCKET in scripts/localstack/01-bootstrap.sh.
S3_FILES_BUCKET=opshub-files-dev
CDN_FILES_BASE_URL=

# StorageService reads STORAGE_ENDPOINT, NOT AWS_ENDPOINT_URL — object storage
# selects its backend separately because the bucket may live in Cloudflare R2,
# a different account with different credentials. Without this the S3 client
# talks to real AWS and every upload fails against a bucket you do not own.
# Deployed environments get these from infra; locally they point at LocalStack.
STORAGE_ENDPOINT=http://localhost:4567
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
# LocalStack (and R2) address buckets by path, not by virtual host.
STORAGE_FORCE_PATH_STYLE=true
