{
  "name": "opshub",
  "packageManager": "pnpm@11.28.6",
  "version": "0.4.5",
  "private": true,
  "license": "UNLICENSED",
  "description": "OpsHub — internal IT/HR operations platform (Zone B2). Monorepo: apps/{api,worker,web}",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:migrator": "tsc --project tsconfig.migrator.json",
    "build": "pnpm build:api && pnpm build:worker",
    "build:web": "pnpm --filter opshub-web build",
    "dev:web": "pnpm --filter opshub-web dev",
    "format": "prettier --write \"apps/api/**/*.ts\" \"apps/worker/**/*.ts\" \"libs/**/*.ts\" \"db/**/*.ts\"",
    "start:dev": "GRAPH_CLIENT_ID= AZURE_CLIENT_CERTIFICATE_PATH= GRAPH_FEDERATED_TOKEN_FILE= nest start api --watch",
    "start:dev:worker": "BETTER_AUTH_SECRET= IDENTITY_TEST_LOGIN= ENTRA_CLIENT_SECRET= EDGE_CLIENT_IP_SECRET= EDGE_CLIENT_IP_SECRET_PREVIOUS= nest start worker --watch",
    "start:debug": "GRAPH_CLIENT_ID= AZURE_CLIENT_CERTIFICATE_PATH= GRAPH_FEDERATED_TOKEN_FILE= nest start api --debug --watch",
    "start:prod": "node dist/apps/api/apps/api/src/main.js",
    "start:prod:worker": "node dist/apps/worker/apps/worker/src/main.js",
    "lint": "eslint \"{apps/api,apps/worker,libs,db}/**/*.ts\"",
    "lint:fix": "eslint \"{apps/api,apps/worker,libs,db}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config test/vitest.e2e.config.ts",
    "test:logging-worker": "vitest run --config test/vitest.logging-worker.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "check:coverage-floors": "tsx test/check-coverage-floors.ts",
    "local:check": "tsx scripts/local/check.ts",
    "db:roles:enable": "tsx db/enable-least-privilege-roles.ts",
    "smoke": "python3 scripts/smoke-api.py"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-secrets-manager": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@azure/identity": "^4.13.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.1.1",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@nestjs/common": "^11.2.4",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.4",
    "@nestjs/platform-fastify": "^11.2.4",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@quynhonsemiconductor/identity": "^8.5.2",
    "@quynhonsemiconductor/observability": "^0.6.2",
    "@quynhonsemiconductor/platform-cache": "^3.3.0",
    "@quynhonsemiconductor/platform-db": "^0.1.2",
    "@quynhonsemiconductor/platform-http": "^5.0.2",
    "@quynhonsemiconductor/platform-mail": "^0.1.7",
    "@quynhonsemiconductor/platform-runtime": "^0.3.1",
    "cockatiel": "^4.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "5.12.7",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "10.2.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.11.13",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.4",
    "semver": "7.8.5",
    "supertest": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
